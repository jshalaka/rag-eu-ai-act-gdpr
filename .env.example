# Copy to .env. All variables use the RAG_ prefix. No secrets are committed.
RAG_RAW_DIR=data/raw
RAG_PROCESSED_DIR=data/processed
RAG_LOG_LEVEL=INFO

RAG_VECTOR_STORE=chroma
RAG_EMBEDDER=sentence-transformers
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

RAG_TOP_K=5
RAG_CANDIDATES_PER_RETRIEVER=20
RAG_RERANK_ENABLED=false

# LLM: "ollama" (default, local), "openai" or "anthropic"
RAG_LLM_PROVIDER=ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen2.5:7b
RAG_ANTHROPIC_MODEL=claude-sonnet-5-5
# Only needed when RAG_LLM_PROVIDER=anthropic
RAG_ANTHROPIC_API_KEY=

# Only needed when RAG_LLM_PROVIDER=openai
RAG_OPENAI_MODEL=gpt-6-luna
RAG_OPENAI_REASONING_EFFORT=low
RAG_OPENAI_API_KEY=

# Run history: "sqlite" (local file, no login) or "supabase" (shared Postgres + email/password login).
# Supabase needs the project URL and the *anon (publishable)* key. Never put the service_role key here.
RAG_RUN_STORE=sqlite
RAG_SUPABASE_URL=
RAG_SUPABASE_ANON_KEY=
