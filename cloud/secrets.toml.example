# Paste the real values (never commit them) into the app's Advanced settings > Secrets on
# Streamlit Community Cloud. Keys use the same names as the .env file.
RAG_OPENAI_API_KEY = "sk-..."
RAG_RUN_STORE = "supabase"
RAG_SUPABASE_URL = "https://<project>.supabase.co"
RAG_SUPABASE_ANON_KEY = "<anon / publishable key, never the service_role key>"
# Optional overrides:
# RAG_OPENAI_MODEL = "gpt-6-luna"
# RAG_OPENAI_REASONING_EFFORT = "low"
